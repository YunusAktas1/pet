# .env.example - Development template
# Copy to .env and adjust values

# App
APP_NAME=PetMatch
ENV=development
DEBUG=True
API_V1_STR=/api/v1

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Local dev
DATABASE_URL=postgresql+psycopg2://petuser:petpass@localhost:5432/petmatch
# Docker
# DATABASE_URL=postgresql+psycopg2://petuser:petpass@db:5432/petmatch

# Logging
LOG_LEVEL=info

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Refresh token HMAC secret (>=32 chars). MUST override in production.
REFRESH_TOKEN_HMAC_SECRET=dev-refresh-hmac-secret-change-me-32chars-minimum
